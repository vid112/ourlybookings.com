# Public applications
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_TELEGRAM=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# API and database
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://ourly:ourly_dev_password@localhost:5432/ourly_bookings?schema=public
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
COOKIE_SECRET=replace-with-another-32-random-characters

# Cloudinary signed uploads (optional for local development; required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authorized owner-operated source migration (leave false unless rights are confirmed)
SCHLOKA_IMPORT_AUTHORIZED=false
SCHLOKA_IMPORT_PUBLISH_CONFIRMED=false

# Optional integrations
REDIS_URL=redis://localhost:6379
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ourlybookings@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM=ourlybookings@gmail.com

# Cloudflare Turnstile (required in production for registration, login and ad submission)
TURNSTILE_SECRET_KEY=
