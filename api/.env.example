PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://ourly:ourly_dev_password@localhost:5432/ourly_bookings?schema=public
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
COOKIE_SECRET=replace-with-another-32-random-characters
# Leave blank locally. Use .ourlybookings.com when frontend, API and admin use subdomains.
COOKIE_DOMAIN=
# Optional locally: images are stored in backend/api/uploads when all three values are blank.
# Configure all three Cloudinary values before production deployment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SCHLOKA_IMPORT_AUTHORIZED=false
SCHLOKA_IMPORT_PUBLISH_CONFIRMED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ourlybookings@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM=ourlybookings@gmail.com
GOOGLE_CLIENT_ID=
