{
  "name": "ourly-bookings",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ourly/frontend --filter @ourly/api --filter @ourly/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ourly/api prisma:generate",
    "db:migrate": "pnpm --filter @ourly/api prisma:migrate",
    "db:seed": "pnpm --filter @ourly/api prisma:seed",
    "import:schloka": "pnpm --filter @ourly/api import:schloka"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
